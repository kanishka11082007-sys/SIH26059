# =============================================================================
# PolarNav (SIH PS 26059) Backend Environment Configuration Template
# =============================================================================

OPEN_WATERS_API_KEY=YOUR_OPEN_WATERS_KEY_HERE
OPEN_WATERS_BASE_URL=https://api.openwaters.io/v1

COPERNICUS_MARINE_USERNAME=YOUR_COPERNICUS_USERNAME
COPERNICUS_MARINE_PASSWORD=YOUR_COPERNICUS_PASSWORD

OPEN_METEO_API_KEY=

NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap

# PostgreSQL / PostGIS Database Configuration (Optional)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/polarnav

# Or individual connection variables:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polarnav

PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
