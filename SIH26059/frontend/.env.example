# PolarNav Frontend Environment Configuration Example
# Copy to .env.local for local overrides

# Optional: Custom Geocoding API endpoint or overrides
# VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/search

# Optional: Map Tile Server override (defaults to CartoDB Dark Matter)
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
