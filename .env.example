# =============================================================================
# PolarNav (SIH PS 26059) Environment Configuration Template
# Copy this file to .env and configure your credentials as needed.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LIVE AIS VESSEL TRACKING (OPTIONAL)
# -----------------------------------------------------------------------------
# Purpose: Stream live terrestrial and satellite Automatic Identification System (AIS)
# telemetry for polar research vessels and icebreakers.
# Provider: OpenWaters / Spire Maritime / MarineTraffic
# Registration: https://openwaters.io or https://spire.com/maritime/
# If left empty, the platform automatically operates in DEMO MODE with 8 canonical
# polar research vessels (R/V Sagar Nidhi, R/V Nathaniel B. Palmer, Polarstern, etc.)
OPEN_WATERS_API_KEY=YOUR_OPEN_WATERS_KEY_HERE
OPEN_WATERS_BASE_URL=https://api.openwaters.io/v1

# -----------------------------------------------------------------------------
# 2. E.U. COPERNICUS MARINE SERVICE (OPTIONAL)
# -----------------------------------------------------------------------------
# Purpose: Live querying of daily updated Global Ocean Physics Analysis (GLO12).
# Provider: Copernicus Marine Service / Mercator Ocean
# Registration: https://marine.copernicus.eu (Free user registration)
# If left empty, the platform automatically uses the local authentic Copernicus
# NetCDF dataset: backend/data/raw/ocean/copernicus_currents_real.nc
COPERNICUS_MARINE_USERNAME=YOUR_COPERNICUS_USERNAME
COPERNICUS_MARINE_PASSWORD=YOUR_COPERNICUS_PASSWORD

# -----------------------------------------------------------------------------
# 3. METEOROLOGICAL & WAVE SWELL FEEDS (NO KEY REQUIRED FOR FREE TIER)
# -----------------------------------------------------------------------------
# Purpose: Atmospheric winds, temperatures, pressures, and significant wave heights.
# Provider: Open-Meteo API (https://open-meteo.com)
# Free Tier: Public access without API key up to 10,000 calls/day.
# Commercial Key (Optional):
OPEN_METEO_API_KEY=

# -----------------------------------------------------------------------------
# 4. NOAA COASTWATCH ERDDAP (NO KEY REQUIRED)
# -----------------------------------------------------------------------------
# Purpose: Ingest NOAA/NSIDC CDR Sea Ice Concentration and NOAA ETOPO Bathymetry.
# Provider: NOAA CoastWatch (https://coastwatch.pfeg.noaa.gov/erddap)
# Public Open Access: No API key or registration required.
NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap

# -----------------------------------------------------------------------------
# 5. POSTGRESQL / POSTGIS DATABASE (OPTIONAL)
# -----------------------------------------------------------------------------
# Purpose: Persist polar vessels, COMNAP stations, 85 real BYU/NIC icebergs,
# multi-objective Pareto corridors, safety alerts, and IMO compliance voyage logs.
#
# Option A (Recommended): Full Connection String URL
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# Example: postgresql+psycopg://postgres:postgres@localhost:5432/polarnav
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/polarnav

# Option B: Individual Credential Variables (Used if DATABASE_URL is omitted)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polarnav

# To automatically migrate and seed all datasets into PostgreSQL, run:
# python -m backend.app.seed_db

# -----------------------------------------------------------------------------
# 6. BACKEND & API SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api

