# =============================================================================
# PolarNav (SIH26059) Root Docker Ignore
# Excludes heavy dependencies, local caches, and presentation files from Docker context
# =============================================================================

# Node dependencies & local builds
node_modules/
**/node_modules/
.vite/
**/.vite/

# Python bytecode & virtual environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python

# Version control & OS metadata
.git/
.gitignore
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testing & Logs
.pytest_cache/
*.log

# Presentation decks (kept local)
sih_presentation/
sih_ppt/
