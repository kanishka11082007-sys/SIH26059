# =============================================================================
# RENDER BACKEND ENVIRONMENT VARIABLES (Paste into Render Web Service > Environment)
# Native Python (No Docker)
# =============================================================================

# Python Runtime Version
PYTHON_VERSION=3.11.9

# Server Network Binding (Render assigns $PORT dynamically)
HOST=0.0.0.0

# CORS Configuration (Allows frontend access from Vercel)
CORS_ORIGINS=*

# AI Navigation Copilot (Google Gemini)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash

# Optional: PostgreSQL Database (e.g. Neon, Supabase, Render PostgreSQL)
# If omitted, PolarNav runs in verified in-memory + local NetCDF dataset mode.
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/dbname

# Optional: Live AIS Tracking (Default operates with 8 canonical Antarctic vessels)
# OPEN_WATERS_API_KEY=

# Optional: Copernicus Marine Service
# COPERNICUS_MARINE_USERNAME=
# COPERNICUS_MARINE_PASSWORD=
